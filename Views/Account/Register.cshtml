@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<div class="rd-center-card">
    <h1 class="rd-heading">Create your account</h1>
    <form asp-action="Register" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <label class="form-label">@Html.DisplayNameFor(m => m.Role)</label>
        <div class="rd-role-picker mb-3">
            <input type="radio" class="btn-check" asp-for="Role" value="Participant" id="roleParticipant" />
            <label class="btn btn-outline-primary" for="roleParticipant">Participant</label>
            <input type="radio" class="btn-check" asp-for="Role" value="Organiser" id="roleOrganiser" />
            <label class="btn btn-outline-primary" for="roleOrganiser">Organiser</label>
        </div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" autocomplete="name" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Register</button>
    </form>
    <p class="rd-meta mt-3 mb-0">Already registered? <a asp-action="Login">Log in</a></p>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}