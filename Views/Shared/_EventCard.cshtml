@model EventDto
<div class="card rd-card h-100">
    @if (!string.IsNullOrWhiteSpace(Model.BannerUrl))
    {
        <img src="@Model.BannerUrl" class="rd-card-img" alt="Banner for @Model.EventName" loading="lazy" />
    }
    else
    {
        <div class="rd-card-img rd-card-placeholder"><span>@Model.EventType</span></div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="rd-chip">@Model.EventType</span>
            @if (Model.DistanceKm.HasValue)
            {
                <span class="rd-distance">@Model.DistanceKm.Value.ToString("0.##") km</span>
            }
        </div>
        <h5 class="card-title">@Model.EventName</h5>
        <p class="rd-meta mb-1">@Model.EventDate.ToString("ddd, dd MMM yyyy")</p>
        <p class="rd-meta mb-3">@Model.Location</p>
        <a class="btn btn-primary mt-auto" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">View event</a>
    </div>
</div>