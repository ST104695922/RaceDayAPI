@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="rd-center-card text-center">
    <h1 class="rd-heading">Off the course</h1>
    <p class="lead">@Model.Message</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to the start line</a>
    @if (Model.ShowRequestId)
    {
        <p class="rd-meta mt-4">Reference: <code>@Model.RequestId</code></p>
    }
</div>