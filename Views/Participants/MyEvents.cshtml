@model List<EnrolmentDto>
@{ ViewData["Title"] = "My Events"; }

<div class="rd-page-head">
    <h1 class="rd-heading">My events</h1>
    <p class="rd-meta">Every event you have entered, with its current status.</p>
</div>

@if (Model.Count == 0)
{
    <div class="rd-empty">
        <h3>You have not entered any events yet</h3>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Browse events</a>
    </div>
}
else
{
    <div class="rd-panel p-0">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Location</th><th>Category</th><th>Entry fee</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId" class="fw-semibold">@e.EventName</a></td>
                            <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@e.Location</td>
                            <td>@e.CategoryName</td>
                            <td>R @e.EntryFee.ToString("N2")</td>
                            <td><partial name="_StatusBadge" model="e.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}