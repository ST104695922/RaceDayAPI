@model EventFormViewModel
@{
    bool isEdit = !string.IsNullOrWhiteSpace(Model.EventId);
    ViewData["Title"] = isEdit ? "Edit event" : "New event";
}

<a asp-action="Events" class="rd-back">&larr; Manage events</a>
<div class="rd-page-head"><h1 class="rd-heading">@(isEdit ? "Edit event" : "Create an event")</h1></div>

<div class="rd-panel">
    <form asp-action="@(isEdit ? "EditEvent" : "CreateEvent")" method="post" enctype="multipart/form-data" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="EventId" />
        <input type="hidden" asp-for="ExistingBannerUrl" />

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="EventName" class="form-label"></label>
                <input asp-for="EventName" class="form-control" />
                <span asp-validation-for="EventName" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select" asp-items="@(new SelectList(DisplayHelper.EventTypes))"></select>
                <span asp-validation-for="EventType" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="DistanceKm" class="text-danger"></span>
            </div>

            @if (isEdit)
            {
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select" asp-items="@(new SelectList(DisplayHelper.EventStatuses))"></select>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="Status" />
            }

            <div class="col-12">
                <label asp-for="Banner" class="form-label"></label>
                @if (!string.IsNullOrWhiteSpace(Model.ExistingBannerUrl))
                {
                    <div class="mb-2"><img src="@Model.ExistingBannerUrl" alt="Current banner" class="rd-banner-thumb" /></div>
                }
                <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp" />
                <div class="form-text">JPG, PNG, GIF or WEBP, up to 5 MB. @(isEdit ? "Choose a file to replace the current banner." : "")</div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Create event")</button>
            <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}