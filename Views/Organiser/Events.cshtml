@model List<OrganiserEventDto>
@{
    ViewData["Title"] = "Manage events";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 rd-page-head">
    <div>
        <h1 class="rd-heading mb-0">Manage events</h1>
        <p class="rd-meta mb-0">Create, edit and delete your events.</p>
    </div>
    <a class="btn btn-primary" asp-action="CreateEvent">+ New event</a>
</div>

@if (Model.Count == 0)
{
    <div class="rd-empty"><h3>No events yet</h3><a class="btn btn-primary" asp-action="CreateEvent">Create an event</a></div>
}
else
{
    <div class="row g-4">
        @foreach (var e in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card rd-card h-100">
                    @if (!string.IsNullOrWhiteSpace(e.BannerUrl))
                    {
                        <img src="@e.BannerUrl" class="rd-card-img" alt="Banner for @e.EventName" loading="lazy" />
                    }
                    else
                    {
                        <div class="rd-card-img rd-card-placeholder"><span>@e.EventType</span></div>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="rd-chip">@e.EventType</span>
                            <partial name="_StatusBadge" model="e.Status" />
                        </div>
                        <h5 class="card-title">@e.EventName</h5>
                        <p class="rd-meta mb-1">@e.EventDate.ToString("ddd, dd MMM yyyy") &middot; @e.Location</p>
                        <p class="rd-meta mb-3">@(e.DistanceKm.HasValue? e.DistanceKm.Value.ToString("0.##") + " km" : "Distance not set") &middot; @e.EnrolmentCount enrolled</p>

                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            <a class="btn btn-sm btn-primary" asp-action="EditEvent" asp-route-id="@e.EventId">Edit</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Categories" asp-route-id="@e.EventId">Categories</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Enrolments" asp-route-id="@e.EventId">Enrolments</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Results" asp-route-id="@e.EventId">Results</a>
                            <form asp-action="DeleteEvent" method="post" class="ms-auto"
                                  onsubmit="return confirm('Delete @e.EventName.Replace("'", "\\'")? This cannot be undone.');">
                                <input type="hidden" name="id" value="@e.EventId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}