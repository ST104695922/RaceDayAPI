@model CategoriesViewModel
@{
    ViewData["Title"] = "Categories";
}

<a asp-action="Events" class="rd-back">&larr; Manage events</a>
<div class="rd-page-head">
    <h1 class="rd-heading mb-0">Categories</h1>
    <p class="rd-meta">@Model.Event.EventName &middot; @Model.Event.EventDate.ToString("dd MMM yyyy")</p>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        @if (Model.Categories.Count == 0)
        {
            <div class="rd-empty"><p class="mb-0">No categories yet. Add one using the form.</p></div>
        }
        else
        {
            <div class="rd-panel p-0">
                <table class="table rd-table align-middle mb-0">
                    <thead><tr><th>Category</th><th>Distance</th><th>Entry fee</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.Categories)
                        {
                            <tr>
                                <td class="fw-semibold">@c.CategoryName</td>
                                <td>@c.DistanceKm.ToString("0.##") km</td>
                                <td>R @c.EntryFee.ToString("N2")</td>
                                <td class="text-end">
                                    <form asp-action="DeleteCategory" method="post" onsubmit="return confirm('Remove this category?');">
                                        <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                                        <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="col-lg-5">
        <div class="rd-panel">
            <h5 class="mb-3">Add a category</h5>
            <form asp-action="AddCategory" method="post" novalidate>
                <input type="hidden" asp-for="NewCategory.EventId" />
                <div class="mb-3">
                    <label asp-for="NewCategory.CategoryName" class="form-label"></label>
                    <input asp-for="NewCategory.CategoryName" class="form-control" placeholder="e.g. Under 20, Open 10 km" />
                    <span asp-validation-for="NewCategory.CategoryName" class="text-danger"></span>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label asp-for="NewCategory.DistanceKm" class="form-label"></label>
                        <input asp-for="NewCategory.DistanceKm" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="NewCategory.DistanceKm" class="text-danger"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.EntryFee" class="form-label"></label>
                        <input asp-for="NewCategory.EntryFee" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="NewCategory.EntryFee" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Add category</button>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}